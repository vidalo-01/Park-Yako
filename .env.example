# Daraja 3.0 credentials — never commit real values.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_stk_passkey

# Must be reachable by Safaricom. For production, use HTTPS.
# Example: https://your-domain.example/payments/callback
MPESA_CALLBACK_URL=https://your-public-domain.example/payments/callback

# Optional; defaults to CustomerPayBillOnline.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Park Yako staff login
STAFF_USERNAME=staff
STAFF_PASSWORD=ParkYako@123
FLASK_SECRET_KEY=change-this-to-a-random-secret
